# Database connection URL (Default SQLite for easy local setup, easily replaced by PostgreSQL in production)
DATABASE_URL="file:./dev.db"

# Secret key used for signing JWT authentication session tokens
JWT_SECRET="omnispace-super-secret-key-32chars-long-secure-random"

# Google Gemini API Key (Get a free key at https://aistudio.google.com/)
GEMINI_API_KEY=""

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
